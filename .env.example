# ===================================
# Paws&Co. — Environment Variables
# ===================================

# --- App ---
NEXT_PUBLIC_APP_NAME="Paws&Co."
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_LANGUAGE=th

# --- Auth ---
JWT_SECRET=pawsandco-dev-secret-key-change-in-production-2026

# --- IoT device provisioning (server-only; never prefix with NEXT_PUBLIC_) ---
# Format: deviceId:key,deviceId:key
IOT_DEVICE_KEYS="dev_lilygo_01:replace-with-a-long-random-device-key,dev_lilygo_02:replace-with-another-key"
# Optional. Defaults to .runtime/iot-telemetry.jsonl
# IOT_TELEMETRY_FILE="D:/data/pawsandco/iot-telemetry.jsonl"

# --- Database (optional in demo mode) ---
DATABASE_URL="postgresql://pawsandco:pawsandco@localhost:5432/pawsandco?schema=public"

# --- Google Maps (Phase 2) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- MQTT (optional future transport) ---
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
